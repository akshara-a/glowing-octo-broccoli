import pandas as pd
import duckdb

data = {
    "employee_id": [1, 2, 3, 4, 5, 6, 7, 8],
    "name": ["Asha", "Rahul", "Neha", "Vikram", "Priya", "Arjun", "Meera", "Karan"],
    "department": ["IT", "HR", "IT", "Finance", "HR", "Finance", "IT", "Sales"],
    "salary": [60000, 45000, 70000, 55000, 48000, 65000, 75000, 50000],
    "city": ["Delhi", "Mumbai", "Bengaluru", "Delhi", "Mumbai", "Chennai", "Bengaluru", "Delhi"]
}

df = pd.DataFrame(data)
df.to_parquet("employees.parquet", index=False)
print("Task 1: Parquet file created.")

print("\nTask 2:")
print(duckdb.sql("SELECT * FROM read_parquet('employees.parquet')").df())

print("\nTask 3a: salary > 50000")
print(duckdb.sql("SELECT * FROM read_parquet('employees.parquet') WHERE salary > 50000").df())

print("\nTask 3b: IT department")
print(duckdb.sql("SELECT * FROM read_parquet('employees.parquet') WHERE department = 'IT'").df())

print("\nTask 3c: Delhi")
print(duckdb.sql("SELECT * FROM read_parquet('employees.parquet') WHERE city = 'Delhi'").df())

print("\nTask 3d: IT salary > 65000")
print(duckdb.sql("SELECT * FROM read_parquet('employees.parquet') WHERE department='IT' AND salary>65000").df())

print("\nTask 4:")
print(duckdb.sql("SELECT name,department,salary FROM read_parquet('employees.parquet') ORDER BY salary DESC").df())

print("\nTask 5:")
print(duckdb.sql("SELECT COUNT(*) AS count, AVG(salary) AS avg, MAX(salary) AS max, MIN(salary) AS min, SUM(salary) AS total FROM read_parquet('employees.parquet')").df())

print("\nTask 6:")
print(duckdb.sql("SELECT department, COUNT(*) AS count, AVG(salary) AS avg, MAX(salary) AS max, SUM(salary) AS total FROM read_parquet('employees.parquet') GROUP BY department ORDER BY avg DESC").df())

con = duckdb.connect("company.duckdb")
con.execute("CREATE OR REPLACE TABLE employees AS SELECT * FROM read_parquet('employees.parquet')")
print("\nTask 7:")
print(con.execute("SELECT * FROM employees").df())
con.close()

duckdb.sql("COPY (SELECT * FROM read_parquet('employees.parquet') WHERE salary > 50000) TO 'high_salary_employees.parquet' (FORMAT PARQUET)")
print("\nTask 8: high_salary_employees.parquet created.")

print("\nTask 9:")
print(duckdb.sql("SELECT * FROM read_parquet('high_salary_employees.parquet')").df())

print("\nBonus 1:")
print(duckdb.sql("SELECT * FROM read_parquet('employees.parquet') ORDER BY salary DESC LIMIT 1 OFFSET 1").df())

print("\nBonus 2:")
print(duckdb.sql("SELECT * FROM read_parquet('employees.parquet') ORDER BY salary DESC LIMIT 3").df())

print("\nBonus 3:")
print(duckdb.sql("SELECT city, AVG(salary) AS avg_salary FROM read_parquet('employees.parquet') GROUP BY city").df())

print("\nBonus 4:")
print(duckdb.sql("SELECT department, AVG(salary) AS avg FROM read_parquet('employees.parquet') GROUP BY department HAVING AVG(salary)>55000").df())

print("\nBonus 5:")
print(duckdb.sql("SELECT name, salary, CASE WHEN salary>=65000 THEN 'High' WHEN salary>=50000 THEN 'Medium' ELSE 'Low' END AS salary_category FROM read_parquet('employees.parquet')").df())

print("\nAll tasks completed!")
